# Copy to .env next to docker-compose.yml (never commit it).

# Claude — ONE of the two, always the client's own account:
#  a) Claude subscription: on their computer run `claude setup-token` and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
#  b) API (billed per use): console.anthropic.com → API keys.
ANTHROPIC_API_KEY=

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → Create → Docker → copy the token).
TUNNEL_TOKEN=

# Cloudflare Access (Zero Trust → Access → Applications → the CRM app): team name and Application Audience (AUD) tag.
# With both set the CRM rejects any request that did not pass Access login.
CF_ACCESS_TEAM=
CF_ACCESS_AUD=

# Timezone for cron/jobs and dates.
TZ=America/Guyana
